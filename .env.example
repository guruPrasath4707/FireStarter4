# Firebase web app configuration (Firebase Console -> Project settings -> Your apps)
# These values are public client configuration; never place service-account credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional API server base URL. The app's API client defaults to http://localhost:5000.
VITE_API_URL=http://localhost:5000
